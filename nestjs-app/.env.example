# ===========================================
# The Quest Weaver's Essential Guide - Environment Configuration
# ===========================================

# -----------------
# Application Config
# -----------------
NODE_ENV=development
PORT=3000

# -----------------
# CORS Configuration
# -----------------
CORS_ORIGIN=http://localhost:3000

# -----------------
# Database
# -----------------
# SQLite database file path (relative to nestjs-app directory)
DB_PATH=./data/game.db

# -----------------
# LLM Configuration
# -----------------
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local LLM Configuration (for Ollama, LM Studio, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3:7b

# LLM Settings
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3
LLM_DEFAULT_PROVIDER=openai

# -----------------
# Text-to-Speech (TTS) Configuration
# -----------------
# Kokoro TTS (Native Node.js - Recommended)
TTS_KOKORO_ENABLED=true
TTS_KOKORO_GPU=false
TTS_KOKORO_MODEL_SIZE=q8
# Model sizes: q8 (200MB, recommended), q4 (100MB, faster), fp16 (164MB, best quality)
TTS_DEFAULT_VOICE=af_bella
TTS_SPEED=1.0
TTS_FORMAT=mp3
# Available voices: af_bella, af_sarah, af_nicole, am_adam, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis

# Python TTS (Optional - for Coqui TTS, Piper, etc.)
TTS_PYTHON_ENABLED=false

# HTTP TTS (Optional - for external TTS services)
TTS_HTTP_ENABLED=false
# TTS_API_URL=http://localhost:5000/tts
# TTS_API_KEY=your_tts_api_key_here

# -----------------
# Speech-to-Text (STT) Configuration
# -----------------
# Whisper settings
STT_ENABLED=true
STT_MODEL=base.en
STT_LANGUAGE=en
# Available models: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v2, large-v3
# Larger models = better accuracy but slower and more VRAM

# -----------------
# Image Generation Configuration
# -----------------
IMAGE_GEN_ENABLED=true

# ComfyUI Server Configuration
COMFYUI_HOST=localhost:8188
COMFYUI_TIMEOUT=120000

# Model Selection
IMAGE_GEN_MODEL=sdxl
# Options: sdxl, sd3, flux-schnell

# Default Generation Settings
IMAGE_GEN_DEFAULT_WIDTH=1024
IMAGE_GEN_DEFAULT_HEIGHT=1024
IMAGE_GEN_DEFAULT_STEPS=20
IMAGE_GEN_DEFAULT_CFG=7.5

# VRAM Management
IMAGE_GEN_VRAM_LIMIT=13000
IMAGE_GEN_OFFLOAD_TIMEOUT=300000

# -----------------
# Redis Configuration (for BullMQ)
# -----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------
# Queue Configuration
# -----------------
IMAGE_QUEUE_CONCURRENCY=1
IMAGE_QUEUE_MAX_RATE=10
IMAGE_QUEUE_RATE_WINDOW=60000

# -----------------
# Model Paths (optional - for custom model locations)
# -----------------
# SDXL_MODEL_PATH=/path/to/models/sdxl
# SD3_MODEL_PATH=/path/to/models/sd3-medium
# FLUX_MODEL_PATH=/path/to/models/flux-schnell

# -----------------
# Logging
# -----------------
LOG_LEVEL=debug
# Options: error, warn, log, debug, verbose

# -----------------
# Security
# -----------------
# JWT Secret (if implementing authentication)
# JWT_SECRET=your_secret_key_here
# JWT_EXPIRATION=7d

# Rate Limiting (future implementation)
# RATE_LIMIT_TTL=60
# RATE_LIMIT_MAX=100
