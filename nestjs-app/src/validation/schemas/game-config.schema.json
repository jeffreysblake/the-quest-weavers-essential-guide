{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "game-config.schema.json",
  "title": "Game Configuration",
  "description": "Schema for game configuration file",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique game identifier (lowercase alphanumeric with hyphens)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable game name"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Game description"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Game version number"
    },
    "author": {
      "type": "string",
      "maxLength": 200,
      "description": "Game author name"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether game is active"
    },
    "starting_room": {
      "type": "string",
      "description": "ID of the starting room"
    },
    "metadata": {
      "type": "object",
      "description": "Additional game metadata"
    }
  },
  "additionalProperties": false
}
