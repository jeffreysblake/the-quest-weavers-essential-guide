{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "connection.schema.json",
  "title": "Room Connections",
  "description": "Schema for room connections file",
  "type": "object",
  "required": ["connections"],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_room", "to_room", "direction"],
        "properties": {
          "from_room": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1,
            "maxLength": 100,
            "description": "Source room ID"
          },
          "to_room": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1,
            "maxLength": 100,
            "description": "Destination room ID"
          },
          "direction": {
            "type": "string",
            "enum": ["north", "south", "east", "west", "northeast", "northwest", "southeast", "southwest", "up", "down", "in", "out"],
            "description": "Direction of travel"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Connection description"
          },
          "is_locked": {
            "type": "boolean",
            "description": "Whether connection is locked"
          },
          "required_key": {
            "type": ["string", "null"],
            "description": "ID of key object required to unlock (or null if no key required)"
          },
          "is_hidden": {
            "type": "boolean",
            "description": "Whether connection is hidden from player"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
